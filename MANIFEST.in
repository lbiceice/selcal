# Source-snapshot inputs for the documented examples and development commands.
include .gitignore README.md pyproject.toml uv.lock
recursive-include examples *.py *.csv *.json
include scripts/*.py
recursive-include docs/api *.rst *.py
include docs/benchmarks/in_memory_standard_20260831.json
include docs/benchmarks/in_memory_standard_20260831_figure.svg
include docs/benchmarks/in_memory_standard_20260831_figure.png
include docs/benchmarks/in_memory_standard_20260908.json
include docs/benchmarks/in_memory_standard_20260908_figure.svg
include docs/benchmarks/in_memory_standard_20260908_figure.png
include docs/benchmarks/in_memory_standard_20260922.json
include docs/benchmarks/in_memory_standard_20260922_figure.svg
include docs/benchmarks/in_memory_standard_20260922_figure.png
recursive-include tests *.py *.json *.csv

# Existing wheel data-file destinations remain defined in pyproject.toml.
# Internal evidence and the following exact maintenance tests remain in the
# checkout and continue to be collected there. Product tests remain in the sdist.
# internal dependency evidence and binding
exclude tests/test_dependency_licence_evidence.py
# internal historical receipts and readiness
exclude tests/test_scientific_code_smell_audit.py
# historical verifier receipt and design hashes
exclude tests/test_verifier_complexity_slice_v1.py
# helper for the historical verifier receipt gate
exclude tests/_verifier_structure_gate_v1.py
# fixture for the historical verifier gate
exclude tests/fixtures/verifier_structure_gate_v1.json
# internal trusted-call design assertions
exclude tests/test_internal_design_review.py
# internal authority amendment package
exclude tests/task10/test_authority_amendment_scope_v1.py
# internal authority review package v2
exclude tests/task10/test_authority_review_package_v2.py
# internal authority review package v3
exclude tests/task10/test_authority_review_package_v3.py
# internal authority registry review
exclude tests/task10/test_registry_cross_representation_v1.py
prune docs/superpowers
prune docs/status
prune docs/api/_build
global-exclude __pycache__ *.py[cod] .DS_Store
